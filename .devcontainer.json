{
    "name": "gazoodle/geckolib",
    "build": {
        "dockerfile": ".devcontainer/Dockerfile",
        "context": "."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "charliermarsh.ruff",
                "github.vscode-pull-request-github",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "openai.chatgpt",
                "ryanluker.vscode-coverage-gutters"
            ],
            "settings": {
                "files.eol": "\n",
                "editor.tabSize": 4,
                "editor.formatOnPaste": true,
                "editor.formatOnSave": true,
                "editor.formatOnType": false,
                "files.trimTrailingWhitespace": true,
                "python.analysis.typeCheckingMode": "basic",
                "python.analysis.autoImportCompletions": true,
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff"
                }
            }
        }
    },
    "remoteUser": "vscode",
    "features": {
        "ghcr.io/devcontainers-extra/features/apt-packages:1": {
            "packages": [
                "ffmpeg",
                "libturbojpeg0",
                "libpcap-dev",
                "iputils-ping"
            ]
        }
    },
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached"
    ],
    "postCreateCommand": "pip install -r requirements.txt && tokensave install --agent codex --git-hook no",
    "runArgs": [
        "-v",
        "${localEnv:HOME}${localEnv:USERPROFILE}/.ssh:/tmp/.ssh",
        "--add-host",
        "spa=10.1.209.91"
    ],
    "postStartCommand": "bash scripts/devcontainer-tokensave-sync.sh \"${containerWorkspaceFolder}\""
}
